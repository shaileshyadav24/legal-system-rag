MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=legal_rag
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# Used for revoked-token (logout) lookups and auth-endpoint rate limiting.
# For local dev: docker run -d -p 6379:6379 redis:7
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of browser origins allowed to call either service
# (CORS). No wildcard support - both apps set allow_credentials=True, and
# browsers reject a wildcard Access-Control-Allow-Origin on credentialed
# requests. For local dev, this is typically your frontend's dev server URL.
ALLOWED_ORIGINS=http://localhost:3000

# Resend (https://resend.com) - used to send forgot-password emails.
RESEND_API_KEY=re_your_api_key
# Must be on a domain verified in Resend, e.g. "Your App <noreply@yourdomain.com>".
# For local testing without a verified domain, Resend's own sandbox sender
# "onboarding@resend.dev" works but only delivers to your own Resend account email.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Base URL of the FE's reset-password page; the reset token is appended as ?token=...
PASSWORD_RESET_URL=https://yourapp.example.com/reset-password

# Base URL of the Ollama server the chat service generates answers with.
# For local dev: ollama serve (defaults to this address).
# In a real deployment this must point at a reachable Ollama host - the chat
# service's own Docker image does not run Ollama itself.
OLLAMA_HOST=http://localhost:11434
# Name of the Ollama model to generate answers with - must already be pulled
# on the OLLAMA_HOST server: ollama pull tinyllama
OLLAMA_MODEL=tinyllama

# Optional, Docker-only - not read by libs/shared/config.py, only by each
# Dockerfile's CMD (uvicorn --workers). Number of uvicorn worker processes
# per container; defaults to 4 if unset. Tune to the container's CPU
# allocation, or leave at the default and scale by running more replicas.
# UVICORN_WORKERS=4
