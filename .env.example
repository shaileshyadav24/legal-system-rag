MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=legal_rag
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# Resend (https://resend.com) - used to send forgot-password emails.
RESEND_API_KEY=re_your_api_key
# Must be on a domain verified in Resend, e.g. "Your App <noreply@yourdomain.com>".
# For local testing without a verified domain, Resend's own sandbox sender
# "onboarding@resend.dev" works but only delivers to your own Resend account email.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Base URL of the FE's reset-password page; the reset token is appended as ?token=...
PASSWORD_RESET_URL=https://yourapp.example.com/reset-password
